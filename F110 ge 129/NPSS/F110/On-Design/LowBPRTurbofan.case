// Define output stream destination
OutFileStream case1 {
    filename = "LowBPRTurbofan.case1";
}


CaseRowViewer Case1 {
    outStreamHandle = "case1";
    titleBody = "???????????????????? Run on ???????? at ????????";
    titleVars = { "VERSION",                 "date",     "timeOfDay" }
    variableList = { "AMBIENT.alt=Alt",
                     "AMBIENT.MN=Mn",
                         "PERF.Fn=Fn",
                         "PERF.Fg=Fg",
                         "PERF.TSFC=TSFC"
                       }
}

// Attach post execution processor to sequence
solver.postExecutionSequence.append( "Case1" );

// Run on-design case
setOption( "switchDes", "DESIGN" );
autoSolverSetup();

for (AMBIENT.MN = 0; AMBIENT.MN < 2,01; AMBIENT.MN += 0.1) {
	
	for (AMBIENT.alt = 0; AMBIENT.alt < 60001; AMBIENT.alt += 2500
		CASE++;
		run();
	
	
	}	
	
}


CASE++;
run();
ncpView.display();
