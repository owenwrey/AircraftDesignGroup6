solver.maxIterations = 100;


OutFileStream case1 {
    filename = "test.case1";
}

CaseColumnViewer Case1 {
    outStreamHandle = "case1";
    titleBody = "???????????????????? Run on ???????? at ????????";
    titleVars = { "VERSION",                 "date",     "timeOfDay" }
	variableList = { "AMBIENT.alt = ALT",
				"AMBIENT.MN:?.????=Mn",
				"PERF.TSFC:??.?????????=TSFC",
				"PERF.Fn:??????????.?=Fn",
				"(0.5*FL0.gamt*AMBIENT.Ps*AMBIENT.MN*AMBIENT.MN): ???????????.??????=q_out"
				}

		}
solver.postExecutionSequence.append( "Case1" );



setOption( "switchDes", "DESIGN" );
autoSolverSetup();
CASE++;
run();




