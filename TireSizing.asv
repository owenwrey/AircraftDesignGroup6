clc
close all
clear all
%% Constants %%
A_D = 1.59;
B_D = 0.302;
W_Landing = 85301;

A_W = 0.098;
B_W = 0.467;
P=200;
g = 32.2;
V_stall = 131;
%% Diameter
D_main = A_D*(0.45*W_Landing)^B_D
D_nose = A_D*(0.1*W_Landing)^B_D

%% Width %%
W_main = A_W*(0.45*W_Landing)^B_W
W_nose = A_W*(0.1*W_Landing)^B_W

%% Footprint Area %%
A_p_mw = (W_Landing*0.45)/P
A_p_nw = (W_Landing*0.1)/P

%% Radius From Footprint Area %%
R_r_mw = (D_main/2)-A_p_mw/(2.3*sqrt(W_main*D_main))
R_r_nw = (D_nose/2)-A_p_nw/(2.3*sqrt(W_nose*D_nose))

%% Brake Sizing %%
KE_braking = (0.5*(W_Landing/g)*V_stall^2)
% Wheel diameter ` 