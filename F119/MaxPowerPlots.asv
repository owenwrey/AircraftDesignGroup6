% plot max power thrust vs. Mach number
figure;
plot(Mn_0, Fn_0)
hold on
plot(Mn_10, Fn_10)
plot(Mn_20, Fn_20)
plot(Mn_30, Fn_30)
plot(Mn_40, Fn_40)
plot(Mn_50, Fn_50)
xlabel("Mach Number")
ylabel("Thrust (lb)")
legend("0 kft","10 kft", "20 kft", "30 kft", "40 kft", "50 kft")

% plot TSFC vs. Mach number
figure;
plot(Mn_0, TSFC_0)
hold on
plot(Mn_10, TSFC_10)
plot(Mn_20, TSFC_20)
plot(Mn_30, TSFC_30)
plot(Mn_40, TSFC_40)
plot(Mn_50, TSFC_50)
